{
	"name": "astro-asciinema",
	"version": "0.1.0",
	"description": "Astro integration and component for embedding asciinema terminal recordings",
	"author": "Nicolas Hedger <nicolas@hedger.ch>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nhedger/astro-asciinema.git"
	},
	"homepage": "https://github.com/nhedger/astro-asciinema#readme",
	"bugs": {
		"url": "https://github.com/nhedger/astro-asciinema/issues"
	},
	"keywords": [
		"asciinema",
		"terminal",
		"recording",
		"astro",
		"astro-component",
		"astro-integration",
		"withastro"
	],
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.astro",
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"astro": "./dist/index.js",
			"import": "./dist/integration.js"
		}
	},
	"scripts": {
		"build": "astro check && tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "astro check",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"astro": "^7.0.0"
	},
	"dependencies": {
		"asciinema-player": "^3.17.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.5.4",
		"astro": "^7.1.3",
		"git-cliff": "^2.13.1",
		"happy-dom": "^20.11.0",
		"tsdown": "^0.22.12",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.11.0"
}
